@model RestaurantAppFrontend.Models.Booking

<form asp-action="UpdateBooking" asp-controller="Booking" method="post">
    <input type="hidden" asp-for="Id" />
    <div class="form-group">
        <label asp-for="PartySize" class="control-label"></label>
        <input asp-for="PartySize" class="form-control" placeholder="@Model.PartySize" />
    </div>
    <div class="form-group">
        <label asp-for="StartDateTime" class="control-label"></label>
        <input asp-for="StartDateTime" class="form-control" type="datetime-local" value="@Model.StartDateTime.ToString("yyyy-MM-ddTHH:mm")" />
    </div>
    <div class="form-group">
        <label asp-for="EndDateTime" class="control-label"></label>
        <input asp-for="EndDateTime" class="form-control" type="datetime-local" value="@Model.EndDateTime.ToString("yyyy-MM-ddTHH:mm")" />
    </div>
    <div class="form-group">
        <label asp-for="CustomerId" class="control-label"></label>
        <input asp-for="CustomerId" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="TableId" class="control-label"></label>
        <input asp-for="TableId" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary">Update</button>
</form>
